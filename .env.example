# Storage
RECORDER_DB_PATH=data/recorder.db
SQLITE_BUSY_TIMEOUT_MS=5000
STARTUP_INTEGRITY_CHECK_MODE=quick

# Logging
LOG_LEVEL=INFO
LOG_JSON=true

# Polymarket endpoints
GAMMA_API_URL=https://gamma-api.polymarket.com
CLOB_API_URL=https://clob.polymarket.com
DATA_API_URL=https://data-api.polymarket.com
CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# Loop timing
DISCOVERY_INTERVAL_SEC=120
DISCOVERY_PAGE_SIZE=500
DISCOVERY_MAX_PAGES=60
DISCOVERY_LOOKAHEAD_SEC=7200
SNAPSHOT_INTERVAL_SEC=1
TRADE_BACKFILL_INTERVAL_SEC=120
ENABLE_TRADE_BACKFILL=false

# Market coverage
TRACKED_MARKETS_LIMIT=0
STARTUP_ORDERBOOK_CONCURRENCY=20
ORDERBOOK_LEVELS_TO_STORE=10
FEATURE_ORDERBOOK_DEPTH=5

# Network / reconnect
REQUEST_TIMEOUT_SEC=20
WS_PING_INTERVAL_SEC=20
WS_PING_TIMEOUT_SEC=20
WS_RECONNECT_MIN_SEC=1
WS_RECONNECT_MAX_SEC=30

# Feature settings
JUMP_THRESHOLD=0.05

# Health logging cadence
HEARTBEAT_LOG_INTERVAL_SEC=30

# BTC RTDS price feed
BTC_PRICE_FEED_ENABLED=false
BTC_PRICE_FEED_SOURCES=
BTC_PRICE_FEED_SOURCE=mock
BTC_PRICE_FEED_SYMBOL=btc/usd
BTC_PRICE_FEED_INTERVAL_SEC=1
BTC_PRICE_FEED_WS_URL=wss://ws-live-data.polymarket.com
BTC_PRICE_FEED_STALE_RECONNECT_SEC=10

# Raw CLOB websocket event archival. Disabled by default for live 24/7 runs because
# this table grows quickly and can dominate SQLite write/index cost.
RAW_WS_EVENTS_ENABLED=false
RAW_WS_EVENTS_RETENTION_SEC=0
RAW_WS_EVENTS_MAX_ROWS=0
RAW_WS_EVENTS_PRUNE_INTERVAL_SEC=300
RAW_WS_EVENTS_PRUNE_BATCH_SIZE=50000

# WAL maintenance. Runtime checkpointing should stay infrequent; use the explicit
# wal-checkpoint command with TRUNCATE when the recorder is stopped.
SQLITE_WAL_CHECKPOINT_INTERVAL_SEC=300
SQLITE_WAL_CHECKPOINT_MODE=PASSIVE

# Feed freshness and timeouts
BTC_PRICE_MAX_EXCHANGE_AGE_SEC=15
BTC_PRICE_DROP_STALE=true
BTC_PRICE_STALE_RECONNECT_SEC=30
BTC_PRICE_FEED_STARTUP_TIMEOUT_SEC=5
BTC_PRICE_FEED_SAMPLE_TIMEOUT_SEC=2
BTC_PRICE_BINANCE_REST_URL=https://api.binance.com/api/v3/ticker/24hr

# Market lifecycle metadata maintenance (does not enable real orders)
AUTO_NORMALIZE_RESOLUTIONS_ENABLED=true
AUTO_NORMALIZE_RESOLUTIONS_INTERVAL_SEC=60
AUTO_REPAIR_STALE_ACTIVE_ENABLED=true
AUTO_REPAIR_STALE_ACTIVE_INTERVAL_SEC=300
AUTO_REPAIR_STALE_ACTIVE_GRACE_SEC=60
